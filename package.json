    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.10",
    "tsup": "^8.5.0",
    "typescript": "^7.0.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bunizao/edstem-cli.git"
  },
  "bugs": {
    "url": "https://github.com/bunizao/edstem-cli/issues"
  },
  "homepage": "https://github.com/bunizao/edstem-cli#readme"
