{
  "name": "edstem-cli",
  "version": "0.4.0",
  "description": "Agent-first CLI and MCP server for Ed Discussion",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "npm@11.14.1",
  "bin": {
    "edstem": "dist/edstem.js",
    "edstem-mcp": "dist/edstem-mcp.js"
  },
  "files": [
    "dist",
    "README.md",
    "SKILL.md",
    "LICENSE"
  ],
  "scripts": {
