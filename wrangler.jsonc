{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "edstem-mcp",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-31",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "vars": {
    "ED_API_BASE_URL": "https://edstem.org/api/"
  }
}
